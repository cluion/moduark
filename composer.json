{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cluion/moduark",
    "description": "Laravel-native modular architecture toolkit.",
    "keywords": [
        "architecture",
        "laravel",
        "modular-monolith",
        "modules",
        "static-analysis"
    ],
    "homepage": "https://github.com/cluion/moduark",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cluion"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.1",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "nikic/php-parser": "^5.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cluion\\Moduark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Benchmarks\\": "benchmarks/",
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "post-autoload-dump": [
            "@prepare"
        ],
        "test": [
            "@prepare",
            "@php vendor/bin/phpunit"
        ],
        "test:unit": [
            "@prepare",
            "@php vendor/bin/phpunit --testsuite=Unit"
        ],
        "test:feature": [
            "@prepare",
            "@php vendor/bin/phpunit --testsuite=Feature"
        ],
        "test:dependencies": "@php tests/Compatibility/run.php",
        "test:distribution": "@php vendor/bin/phpunit tests/Distribution",
        "test:installation": "@php tests/Installation/run.php",
        "test:interop": "@php tests/Interop/run.php",
        "test:performance": "@php benchmarks/generation.php --enforce",
        "benchmark": "@benchmark:architecture",
        "benchmark:architecture": "@php benchmarks/run.php",
        "benchmark:generation": "@php benchmarks/generation.php",
        "analyse": "@php vendor/bin/phpstan analyse --ansi --memory-limit=1G",
        "verify": [
            "@test",
            "@analyse"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cluion\\Moduark\\ModuarkServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
